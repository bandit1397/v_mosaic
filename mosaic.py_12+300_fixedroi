import cv2
import os
import sys
import time

# =============================
# 파일 설정
# =============================
INPUT_VIDEO = "input.mp4"
OUTPUT_VIDEO = "output_mosaic.mp4"

# =============================
# OUTPUT 우선 로드
# =============================
if os.path.exists(OUTPUT_VIDEO):
    video_path = OUTPUT_VIDEO
else:
    video_path = INPUT_VIDEO

print("작업 기준 영상:", video_path)

cap = cv2.VideoCapture(video_path)

if not cap.isOpened():
    print("영상 파일을 열 수 없습니다.")
    sys.exit()

fps = cap.get(cv2.CAP_PROP_FPS)
if fps is None or fps <= 0:
    fps = 30

origin_frames = []
BATCH_SIZE = 300
real_total_frames = 0

# =============================
# 안전 배치 로드
# =============================
def load_until(target_index):
    global real_total_frames

    while len(origin_frames) <= target_index:
        count = 0
        while count < BATCH_SIZE:
            ret, frame = cap.read()
            if not ret:
                real_total_frames = len(origin_frames)
                return
            origin_frames.append(frame.copy())
            count += 1

# 최초 로드
load_until(BATCH_SIZE - 1)

if len(origin_frames) == 0:
    print("영상 프레임이 없습니다.")
    sys.exit()

# 전체 프레임 끝까지 읽기
load_until(10**9)
real_total_frames = len(origin_frames)

print("실제 전체 프레임:", real_total_frames)

# =============================
# 상태 변수
# =============================
current_idx = 0
paused = True
drawing = False
moving_roi_index = None
move_offset_x = 0
move_offset_y = 0

trackers = []

start_x, start_y = 0, 0
fixed_mode = False

WINDOW = "STICKY ROI MOSAIC EDITOR"
TRACKBAR = "FRAME"

cv2.namedWindow(WINDOW)
cv2.setWindowProperty(WINDOW, cv2.WND_PROP_TOPMOST, 1)
cv2.setWindowProperty(WINDOW, cv2.WND_PROP_TOPMOST, 0)

# =============================
# 모자이크
# =============================
def apply_mosaic(frame, roi):
    x, y, w, h = map(int, roi)

    x = max(0, x)
    y = max(0, y)
    w = max(0, w)
    h = max(0, h)

    if w <= 0 or h <= 0:
        return frame

    if x + w > frame.shape[1]:
        w = frame.shape[1] - x
    if y + h > frame.shape[0]:
        h = frame.shape[0] - y

    if w <= 0 or h <= 0:
        return frame

    sub = frame[y:y+h, x:x+w]
    if sub.size == 0:
        return frame

    small = cv2.resize(sub, (max(1, w//20), max(1, h//20)))
    mosaic = cv2.resize(small, (w, h), interpolation=cv2.INTER_NEAREST)
    frame[y:y+h, x:x+w] = mosaic
    return frame

# =============================
# redraw
# =============================
def redraw_current():
    frame = origin_frames[current_idx].copy()

    for t in trackers:
        if t["start"] <= current_idx:

            # 🔥 fixed도 end 체크
            if "end" in t and current_idx > t["end"]:
                continue

            if t["mode"] == "track":
                idx = current_idx - t["start"]
                if 0 <= idx < len(t["history"]):
                    roi = t["history"][idx]
                else:
                    continue
            else:
                roi = t["roi"]

            frame = apply_mosaic(frame, roi)

    return frame

# =============================
# 트랙바
# =============================
def on_trackbar(pos):
    global current_idx, paused
    paused = True
    current_idx = min(pos, real_total_frames - 1)

cv2.createTrackbar(TRACKBAR, WINDOW, 0, real_total_frames - 1, on_trackbar)

# =============================
# 마우스
# =============================
def mouse_callback(event, x, y, flags, param):
    global start_x, start_y, drawing
    global moving_roi_index, move_offset_x, move_offset_y

    if not paused:
        return

    if event == cv2.EVENT_LBUTTONDOWN:

        for i in reversed(range(len(trackers))):
            rx, ry, rw, rh = trackers[i]["roi"]
            if rx <= x <= rx+rw and ry <= y <= ry+rh:
                moving_roi_index = i
                move_offset_x = x - rx
                move_offset_y = y - ry
                return

        drawing = True
        start_x, start_y = x, y

    elif event == cv2.EVENT_MOUSEMOVE:
        if moving_roi_index is not None:
            rx, ry, rw, rh = trackers[moving_roi_index]["roi"]
            trackers[moving_roi_index]["roi"] = (
                x - move_offset_x,
                y - move_offset_y,
                rw,
                rh
            )

    elif event == cv2.EVENT_LBUTTONUP:

        if drawing:
            drawing = False
            rx = min(start_x, x)
            ry = min(start_y, y)
            rw = abs(x - start_x)
            rh = abs(y - start_y)

            if rw > 10 and rh > 10:

                if fixed_mode:
                    trackers.append({
                        "roi": (rx, ry, rw, rh),
                        "start": current_idx,
                        "end": current_idx,  # 🔥 초기 end
                        "mode": "fixed"
                    })
                else:
                    kcf = cv2.legacy.TrackerKCF_create()
                    kcf.init(origin_frames[current_idx], (rx, ry, rw, rh))

                    trackers.append({
                        "roi": (rx, ry, rw, rh),
                        "start": current_idx,
                        "tracker": kcf,
                        "history": [(rx, ry, rw, rh)],
                        "mode": "track"
                    })

        moving_roi_index = None

    elif event == cv2.EVENT_RBUTTONDOWN:
        for i in reversed(range(len(trackers))):
            rx, ry, rw, rh = trackers[i]["roi"]
            if rx <= x <= rx+rw and ry <= y <= ry+rh:
                trackers.pop(i)
                break

cv2.setMouseCallback(WINDOW, mouse_callback)

# =============================
# 메인 루프
# =============================
last_processed_frame = 0

while True:

    if not paused:
        current_idx += 1

        if current_idx >= real_total_frames:
            current_idx = real_total_frames - 1
            paused = True

        for t in trackers:

            if t["start"] <= current_idx:

                # 🔥 fixed end 업데이트
                if t["mode"] == "fixed":
                    t["end"] = current_idx

                if t["mode"] == "track":
                    idx = current_idx - t["start"]

                    if idx >= len(t["history"]):
                        success, box = t["tracker"].update(origin_frames[current_idx])
                        if success:
                            t["roi"] = box
                        t["history"].append(t["roi"])

        last_processed_frame = current_idx

    frame = redraw_current()

    mode_text = "FIXED MODE" if fixed_mode else "TRACK MODE"
    cv2.putText(frame, mode_text, (10, 30),
                cv2.FONT_HERSHEY_SIMPLEX, 0.8,
                (0, 0, 255) if fixed_mode else (0, 255, 0), 2)

    if paused:
        for t in trackers:
            if t["start"] <= current_idx:
                x, y, w, h = map(int, t["roi"])
                color = (0,255,0) if t["mode"] == "track" else (0,0,255)
                cv2.rectangle(frame, (x, y), (x+w, y+h), color, 2)

    cv2.imshow(WINDOW, frame)
    cv2.setTrackbarPos(TRACKBAR, WINDOW, current_idx)

    key = cv2.waitKeyEx(10)

    if key == ord('q') or key == ord('Q'):
        break
    elif key == ord('a') or key == ord('A'):
        paused = not paused
    elif key == ord('f') or key == ord('F'):
        fixed_mode = not fixed_mode

cv2.destroyAllWindows()

# =============================
# 저장
# =============================
cap.release()
time.sleep(0.3)

if os.path.exists(OUTPUT_VIDEO):
    for _ in range(5):
        try:
            os.remove(OUTPUT_VIDEO)
            break
        except PermissionError:
            time.sleep(0.3)

h, w, _ = origin_frames[0].shape
fourcc = cv2.VideoWriter_fourcc(*"mp4v")
out = cv2.VideoWriter(OUTPUT_VIDEO, fourcc, fps, (w, h))

for f in range(real_total_frames):

    frame = origin_frames[f].copy()

    for t in trackers:
        if t["start"] <= f:

            # 🔥 fixed end 체크
            if "end" in t and f > t["end"]:
                continue

            if t["mode"] == "track":
                idx = f - t["start"]
                if 0 <= idx < len(t["history"]):
                    roi = t["history"][idx]
                else:
                    continue
            else:
                roi = t["roi"]

            frame = apply_mosaic(frame, roi)

    out.write(frame)

out.release()

print("✅ 전체 프레임 정상 저장 완료:", OUTPUT_VIDEO)
